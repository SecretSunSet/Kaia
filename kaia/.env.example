# ── Required ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# ── Optional: AI fallback ───────────────────────────────────────────
GROQ_API_KEY=

# ── Optional: Web search & briefing ─────────────────────────────────
SERPAPI_KEY=
NEWS_API_KEY=
OPENWEATHER_API_KEY=

# ── Optional: Voice ─────────────────────────────────────────────────
TTS_VOICE=en-US-AriaNeural
VOICE_REPLIES_ENABLED=false

# ── Optional: Access control (comma-separated Telegram user IDs) ────
ALLOWED_TELEGRAM_IDS=

# ── Optional: Tuning ────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024
DEFAULT_TIMEZONE=Asia/Manila
DEFAULT_CURRENCY=PHP
LOG_LEVEL=INFO

# ── R-3: Postgres bus (required once the bus is wired) ──────────────
# Direct Postgres DSN for the asyncpg sidecar. Supabase exposes this
# at Project Settings → Database → Connection String. Prefer the
# connection-pooler URL on port 6543 if available, else direct 5432.
DATABASE_URL=

# Optional: timeout (seconds) for BaseAgent.peer_call (default 30).
# R3_PEER_CALL_TIMEOUT_SECONDS=30
